# REST API connection defaults.
# Update base_url/auth as needed; server reads on startup, so restart to apply.
base_url: "http://domain/AcNaviWebAPI/api/v1"

# Headers and query parameters automatically merged into each request unless
# a tool invocation overrides them.
default_headers:
  Content-Type: "application/json"

default_params: {}

# Authentication (MCP auto-login + token injection)
auth:
  enabled: true
  login_path: "auth/login"       # relative to base_url
  method: "POST"
  payload:
    userID: "user01"
    userPWD: "pass01"
    encryptData: true
  headers:
    Content-Type: "application/json"
  token_field: "token"           # JSON key holding token in login response
  header_name: "X-Api-Auth"      # header to set when calling business APIs
  header_prefix: ""              # prefix before token value; use "" if none

# Fallback timeout (seconds) when a tool request does not provide one.
timeout: 10.0

# Whether to verify TLS certificates. Set to false only for trusted dev targets.
verify_ssl: false

endpoints:
  teikei:
    list:
      method: GET
      path_template: teikei/objects
    detail:
      method: GET
      path_template: teikei/objects/{template_id}
    execute:
      method: POST
      path_template: teikei/objects/search/{template_id}
    update:
      method: PUT
      path_template: teikei/objects/{template_id}
    delete:
      method: DELETE
      path_template: teikei/objects/{template_id}
